# Copy this file to .env and fill in your own values

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=citizen_service_system

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# URL of the Python AI prediction microservice
AI_SERVICE_URL=http://localhost:6000

# Grace period (minutes) before a "Called" token auto-expires
TOKEN_GRACE_PERIOD_MINUTES=5

# Frontend origin allowed to call this API / connect via websocket
CLIENT_ORIGIN=http://localhost:5173
